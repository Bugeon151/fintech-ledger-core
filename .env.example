# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech_ledger
POSTGRES_USER=fintech
POSTGRES_PASSWORD=changeme_local

# ── Kafka (outbox relay) ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
OUTBOX_PUBLISHER=log          # kafka | log
OUTBOX_TOPIC=ledger.transaction-events
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_RETRIES=8

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 64
JWT_SECRET=replace_with_256bit_hex_secret_never_commit_real_value
JWT_ACCESS_EXPIRY_MS=900000       # 15 min
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days
